# =====================================================================
# School ERP — Apache front controller + security headers for /public
# =====================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block dotfiles
    RewriteRule (^|/)\. - [F,L]

    # Block direct access to app/, storage/, database/, vendor/, install/, tests/, cron/
    RewriteRule ^(app|storage|database|vendor|install|tests|cron|import_templates)/ - [F,L]

    # Static assets: skip PHP dispatch
    RewriteCond %{REQUEST_URI} ^/assets/ [OR]
    RewriteCond %{REQUEST_URI} ^/file\.php$
    RewriteRule ^ - [L]

    # Everything else -> index.php (unless a real file exists)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header always unset Server
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set X-Frame-Options "DENY"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
    # HSTS only when HTTPS — mod_headers can conditionally set with env
    SetEnvIf Request_Protocol "https" HTTPS=1
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# Disable directory listing and PHP in uploads (defence in depth — real uploads live outside web root)
Options -Indexes

<FilesMatch "\.(env|lock|md|sql|log|ini|bak|swp|gitignore)$">
    Require all denied
</FilesMatch>

php_flag display_errors off
php_flag log_errors on
php_value session.use_strict_mode 1
php_value session.use_only_cookies 1
php_value session.cookie_httponly 1
php_value session.cookie_samesite Lax
# session.cookie_secure is set at runtime in bootstrap when HTTPS is detected