# ============================================================
# School ERP — environment template. Copy to .env (outside web root).
# Never commit .env. Never put real secrets in .env.example.
# ============================================================

APP_ENV=production
APP_DEBUG=0
APP_NAME="School ERP"
APP_URL=https://erp.example.com
APP_TIMEZONE=Asia/Kolkata
APP_KEY=
APP_KEY_VERSION=1

# Session
SESSION_NAME=SCHOOLERPSESSID
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=28800

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=school_erp
DB_USER=school_erp_app
DB_PASS=
DB_CHARSET=utf8mb4

# Migration/schema-only user (NOT used by the app at runtime)
DB_MIGRATE_USER=school_erp_migrate
DB_MIGRATE_PASS=

# Trusted proxies (comma-separated CIDRs) if behind a load balancer
TRUSTED_PROXIES=

# CSP reporting
CSP_REPORT_URI=/csp-report.php

# Impersonation
IMPERSONATION_TTL=1800