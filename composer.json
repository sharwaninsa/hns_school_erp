{
  "name": "school-erp/core",
  "description": "Multi-tenant School ERP (security-first).",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*",
    "ext-mbstring": "*",
    "ext-json": "*",
    "ext-openssl": "*",
    "ext-gd": "*",
    "ext-fileinfo": "*",
    "ext-sodium": "*",
    "phpoffice/phpspreadsheet": "^2.1",
    "dompdf/dompdf": "^2.0"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "preferred-install": "dist"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  }
}